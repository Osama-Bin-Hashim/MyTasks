<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRequest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:layout_marginVertical="@dimen/_6sdp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_2sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRequestType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btnDeleteRequest"
                android:layout_alignParentStart="true"
                android:text="Join Project"
                android:textColor="#333333"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDeleteRequest"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete"
                app:tint="#999999" />

            <TextView
                android:id="@+id/tvRequestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnDeleteRequest"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@drawable/status_badge_pending"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:text="PENDING"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvRequestSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="From: John Doe"
            android:textColor="#666666"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvRequestProject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Project: Mobile App Alpha"
            android:textColor="#666666"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/tvRequestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="Message text goes here..."
            android:textColor="#333333"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRequestTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Oct 24, 2023 • 10:30 AM"
            android:textColor="#999999"
            android:textSize="@dimen/_10ssp" />

        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReject"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="@color/red"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="Reject"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="@color/green"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="Approve"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
